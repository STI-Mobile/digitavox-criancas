        },
        {
          "id": "stella-1estrela",
          "type": "speech",
          "text": "Missão cumprida, cadete. Uma estrela no seu histórico de voo.",
          "speaker": "stella",
          "asset":"assets/audio/demo/stella/stella-1estrela.wav",
          "fallback": "text"
        },
        {
          "id": "stella-2estrela",
          "type": "speech",
          "text": "Excelente pilotagem! Duas estrelas para você.",
          "speaker": "stella",
          "pending": true,
          "fallback": "text"
        },
        {
          "id": "stella-3estrela",
          "type": "speech",
          "text": "Perfeito! Nem um desvio de rota. Três estrelas, cadete!",
          "speaker": "stella",
          "pending": true,
          "fallback": "text"
        },
        {
          "id": "zero1-diario-intro",
          "type": "speech",
          "text": "Relatório de voo do ZERO-1:",
          "speaker": "zero1",
          "pending": true,
          "fallback": "text"
        },
        {
          "id": "zero1-ajuda",
          "type": "speech",
          "text": "F1 abre ou fecha a ajuda. F2 fala a próxima letra e o dedo. F3 soletra o restante. F4 fala o restante. F5 repete a apresentação da missão. F6 repete as instruções. F7 repete o exercício. F8 fala a hora. F9 abre o diário de bordo. Escape cancela a prática e volta à missão. Tab acessa os controles.",
          "speaker": "zero1",
          "pending": true,
          "fallback": "text"
        },
        {
          "id": "zero1-ajuda-erros",
          "type": "speech",
          "text": "Bip... bip?! Ops... meus parafusos tremeram! Calma, circuitos... calma. Vamos com calma. Continue sem apagar. Se precisar de ajuda... tecle... F1. Bip-bop!",
