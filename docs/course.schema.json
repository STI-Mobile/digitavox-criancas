{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catálogo Digitavox Crianças — schema 2",
  "type": "object",
  "required": ["schemaVersion", "courses"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "courses": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/course" } }
  },
  "$defs": {
    "text": { "type": "string", "pattern": "\\S" },
    "audioCue": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "type": { "enum": ["speech", "sfx", "music"] },
        "text": { "$ref": "#/$defs/text" },
        "asset": { "type": "string", "pattern": "^assets/audio/(?!.*\\.\\.)(?!.*\\\\)(?!.*\\/$).+" },
        "speaker": { "$ref": "#/$defs/text" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "speech" } } },
          "then": { "anyOf": [{ "required": ["text"] }, { "required": ["asset"] }] }
        },
        {
          "if": { "properties": { "type": { "enum": ["sfx", "music"] } } },
          "then": {
            "required": ["asset"],
            "not": { "anyOf": [{ "required": ["text"] }, { "required": ["speaker"] }] }
          }
        }
      ],
      "additionalProperties": false
    },
    "audioGuidance": {
      "type": "object",
      "properties": {
        "start": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/audioCue" } },
        "correctInput": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/audioCue" } },
        "incorrectInput": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/audioCue" } },
        "completed": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/audioCue" } }
      },
      "additionalProperties": false
    },
    "scene": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": { "$ref": "#/$defs/text" },
        "characterId": { "$ref": "#/$defs/text" },
        "audioGuidance": { "$ref": "#/$defs/audioGuidance" }
      }
    },
    "character": {
      "type": "object",
      "required": ["id", "name", "imageAsset", "imageDescription"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "name": { "$ref": "#/$defs/text" },
        "imageAsset": { "type": "string", "pattern": "^assets/images/(?!.*\\.\\.)(?!.*\\\\)(?!.*\\/$).+" },
        "imageDescription": { "$ref": "#/$defs/text" }
      }
    },
    "exercise": {
      "type": "object",
      "required": ["id", "title", "type", "prompt"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "title": { "$ref": "#/$defs/text" },
        "type": { "enum": ["key", "keySequence", "word", "phrase", "timed", "repetition", "challenge"] },
        "prompt": { "$ref": "#/$defs/text" },
        "expectedInput": { "type": ["string", "null"] },
        "minimumRepetitions": { "type": ["integer", "null"], "minimum": 1 },
        "timeLimitSeconds": { "type": ["integer", "null"], "minimum": 1 },
        "audioGuidance": { "$ref": "#/$defs/audioGuidance" },
        "scene": { "$ref": "#/$defs/scene" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "key" } } },
          "then": {
            "required": ["expectedInput"],
            "properties": { "expectedInput": { "type": "string", "pattern": "^[^\\u0000-\\u001f\\u007f]$" } }
          }
        }
      ]
    },
    "lesson": {
      "type": "object",
      "required": ["id", "title", "exercises"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "title": { "$ref": "#/$defs/text" },
        "audioGuidance": { "$ref": "#/$defs/audioGuidance" },
        "scene": { "$ref": "#/$defs/scene" },
        "exercises": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/exercise" } }
      }
    },
    "module": {
      "type": "object",
      "required": ["id", "title", "lessons"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "title": { "$ref": "#/$defs/text" },
        "audioGuidance": { "$ref": "#/$defs/audioGuidance" },
        "scene": { "$ref": "#/$defs/scene" },
        "lessons": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/lesson" } }
      }
    },
    "course": {
      "type": "object",
      "required": ["id", "title", "version", "isDemo", "modules"],
      "properties": {
        "id": { "$ref": "#/$defs/text" },
        "title": { "$ref": "#/$defs/text" },
        "version": { "$ref": "#/$defs/text" },
        "isDemo": { "type": "boolean" },
        "theme": { "$ref": "#/$defs/text" },
        "audioGuidance": { "$ref": "#/$defs/audioGuidance" },
        "scene": { "$ref": "#/$defs/scene" },
        "characters": { "type": "array", "items": { "$ref": "#/$defs/character" } },
        "modules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/module" } }
      }
    }
  }
}
