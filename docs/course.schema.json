          },
          "minItems": 1
        },
        "characterId": {
          "$ref": "#/$defs/text"
        },
        "illustrationId": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "narrationCueIds"
      ],
      "additionalProperties": false
    },
    "character4": {
      "type": "object",
      "required": [
        "id",
        "name",
        "imageAsset",
        "imageDescription"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "imageAsset": {
          "type": "string",
          "pattern": "^assets/images/(?!.*\\.\\.)(?!.*\\\\)(?!.*\\/$).+"
        },
        "imageDescription": {
          "$ref": "#/$defs/text"
        }
      },
      "additionalProperties": false
    },
    "illustration4": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "imageAsset": {
          "type": "string",
          "pattern": "^assets/images/(?!.*\\.\\.)(?!.*\\\\)(?!.*\\/$).+"
        },
        "imageDescription": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "id",
        "title",
        "imageAsset",
        "imageDescription"
      ],
      "additionalProperties": false
    },
    "practice4": {
      "type": "object",
      "properties": {
        "excessiveErrorsThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "caseSensitive": {
          "type": "boolean"
        },
        "keyFingers": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/text"
          },
          "propertyNames": {
            "pattern": "^[^\\u0000-\\u001f\\u007f]$"
          }
        },
        "shortcuts": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "help",
              "nextKey",
              "spellRemaining",
              "remaining",
              "repeatExercise",
              "lessonPresentation",
              "lessonInstruction",
              "currentTime",
              "statistics"
            ]
          },
          "propertyNames": {
            "pattern": "^F[1-9]$"
          }
        },
        "helpCueIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "minItems": 1
        },
        "excessiveErrorsCueIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "minItems": 1
        }
      },
      "required": [
        "excessiveErrorsThreshold",
        "caseSensitive",
        "keyFingers",
        "shortcuts",
        "helpCueIds",
        "excessiveErrorsCueIds"
      ],
      "additionalProperties": false
    },
    "rewards4": {
      "type": "object",
      "properties": {
        "twoStarAccuracy": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "threeStarAccuracy": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "announcementCueIds": {
          "type": "object",
          "properties": {
            "1": {
