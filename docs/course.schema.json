            "badge"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "kind"
      ],
      "additionalProperties": false
    },
    "exercise4": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "type": {
          "enum": [
            "key",
            "keySequence",
            "word",
            "phrase"
          ]
        },
        "prompt": {
          "$ref": "#/$defs/text"
        },
        "expectedInput": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "minimumRepetitions": {
          "type": "integer",
          "minimum": 1
        },
        "timeLimitSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timePerCharacterSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "spellOut": {
