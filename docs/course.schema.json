            " "
          ]
        },
        "trailingSeparator": {
          "enum": [
            "",
            " "
          ]
        },
        "audioGuidance": {
          "$ref": "#/$defs/audioGuidance4"
        },
        "scene": {
          "$ref": "#/$defs/scene4"
        }
      },
      "required": [
        "id",
        "title",
        "type",
        "prompt",
        "expectedInput",
        "minimumRepetitions",
        "spellOut",
        "repetitionSeparator",
        "trailingSeparator"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "key"
              }
            }
          },
          "then": {
            "properties": {
              "expectedInput": {
                "maxLength": 1
              }
            }
          }
        }
      ]
    },
