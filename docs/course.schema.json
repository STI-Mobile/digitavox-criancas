{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catálogo Digitavox Crianças — schemas 2, 3 e 4",
  "oneOf": [
    {
      "$ref": "#/$defs/legacyCatalog"
    },
    {
      "$ref": "#/$defs/catalog4"
    }
  ],
  "$defs": {
    "text": {
      "type": "string",
      "pattern": "\\S"
    },
    "audioCue": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "type": {
          "enum": [
            "speech",
            "sfx",
            "music"
          ]
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "asset": {
          "type": "string",
          "pattern": "^assets/audio/(?!.*\\.\\.)(?!.*\\\\)(?!.*\\/$).+"
        },
        "speaker": {
          "$ref": "#/$defs/text"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "speech"
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "text"
                ]
              },
              {
                "required": [
                  "asset"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "sfx",
                  "music"
                ]
              }
            }
          },
          "then": {
            "required": [
              "asset"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "text"
                  ]
                },
                {
                  "required": [
                    "speaker"
                  ]
                }
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "audioGuidance": {
      "type": "object",
      "properties": {
        "start": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/audioCue"
          }
        },
        "correctInput": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/audioCue"
          }
        },
        "incorrectInput": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/audioCue"
          }
        },
        "completed": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/audioCue"
          }
        }
      },
      "additionalProperties": false
    },
    "scene": {
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "$ref": "#/$defs/text"
        },
        "characterId": {
          "$ref": "#/$defs/text"
        },
        "audioGuidance": {
          "$ref": "#/$defs/audioGuidance"
        }
      }
    },
    "character": {
      "type": "object",
      "required": [
        "id",
        "name",
        "imageAsset",
        "imageDescription"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "imageAsset": {
          "type": "string",
          "pattern": "^assets/images/(?!.*\\.\\.)(?!.*\\\\)(?!.*\\/$).+"
        },
        "imageDescription": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "exercise": {
      "type": "object",
      "required": [
        "id",
        "title",
        "type",
        "prompt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "type": {
          "enum": [
            "key",
            "keySequence",
            "word",
            "phrase",
            "timed",
            "repetition",
            "challenge"
          ]
        },
        "prompt": {
          "$ref": "#/$defs/text"
        },
        "expectedInput": {
          "type": [
            "string",
            "null"
          ]
        },
        "minimumRepetitions": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "timeLimitSeconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "audioGuidance": {
          "$ref": "#/$defs/audioGuidance"
        },
        "scene": {
          "$ref": "#/$defs/scene"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "key"
              }
            }
          },
          "then": {
            "required": [
              "expectedInput"
            ],
            "properties": {
              "expectedInput": {
                "type": "string",
                "pattern": "^[^\\u0000-\\u001f\\u007f]$"
              }
            }
          }
        }
      ]
    },
    "lesson": {
      "type": "object",
      "required": [
        "id",
        "title",
        "exercises"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "audioGuidance": {
          "$ref": "#/$defs/audioGuidance"
        },
        "scene": {
          "$ref": "#/$defs/scene"
        },
        "accuracy": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "secChar": {
          "type": "integer",
          "minimum": 1
        },
        "exercises": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/exercise"
          }
        }
      }
    },
    "module": {
      "type": "object",
      "required": [
        "id",
        "title",
        "lessons"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "audioGuidance": {
          "$ref": "#/$defs/audioGuidance"
        },
        "scene": {
          "$ref": "#/$defs/scene"
        },
        "lessons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/lesson"
          }
        }
      }
    },
    "course": {
      "type": "object",
      "required": [
        "id",
        "title",
        "version",
        "isDemo",
        "modules"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "version": {
          "$ref": "#/$defs/text"
        },
        "isDemo": {
          "type": "boolean"
        },
        "theme": {
          "$ref": "#/$defs/text"
        },
        "audioGuidance": {
          "$ref": "#/$defs/audioGuidance"
        },
        "scene": {
          "$ref": "#/$defs/scene"
        },
        "characters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/character"
          }
        },
        "modules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/module"
          }
        }
      }
    },
    "legacyCatalog": {
      "type": "object",
      "required": [
        "schemaVersion",
        "courses"
      ],
      "properties": {
        "schemaVersion": {
          "enum": [
            2,
            3
          ]
        },
        "courses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/course"
          }
        }
      }
    },
    "audioResource4": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "type": {
          "enum": [
            "speech",
            "sfx",
            "music"
          ]
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "asset": {
          "type": "string",
          "pattern": "^assets/audio/(?!.*\\.\\.)(?!.*\\\\)(?!.*\\/$).+"
        },
        "speaker": {
          "$ref": "#/$defs/text"
        },
        "pending": {
          "type": "boolean"
        },
        "fallback": {
          "enum": [
            "text",
            "silent",
            "systemClick"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "speech"
              }
            }
          },
          "then": {
            "required": [
              "text"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "sfx",
                  "music"
                ]
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "text"
                  ]
                },
                {
                  "required": [
                    "speaker"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "pending": {
                "const": true
              }
            },
            "required": [
              "pending"
            ]
          },
          "then": {
            "required": [
              "fallback"
            ],
            "not": {
              "required": [
                "asset"
              ]
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "speech"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "fallback": {
                      "const": "text"
                    }
                  }
                },
                "else": {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "sfx"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "fallback": {
                        "enum": [
                          "silent",
                          "systemClick"
                        ]
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "fallback": {
                        "const": "silent"
                      }
                    }
                  }
                }
              }
            ]
          },
          "else": {
            "if": {
              "properties": {
                "type": {
                  "enum": [
                    "sfx",
                    "music"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "asset"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "fallback": {
                "const": "systemClick"
              }
            },
            "required": [
              "fallback"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "sfx"
              },
              "pending": {
                "const": true
              }
            },
            "required": [
              "pending"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "audioGuidance4": {
      "type": "object",
      "properties": {
        "start": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "minItems": 1
        },
        "correctInput": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
